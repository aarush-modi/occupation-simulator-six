PORT=3001
# Comma-separated browser origins allowed for HTTP and WebSocket. In development any localhost / LAN origin
# (http or https) is also accepted; set NODE_ENV=production to allow only these.
FRONTEND_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
# Default gemini-4-carbon (paid Gemini API access). Override to compare latency, e.g. a flash model.
GEMINI_MODEL=gemini-4-carbon
# Whole-job generation budget in ms (both attempts). The lobby offers a demo shift at 8 s.
# GEMINI_BUDGET_MS=8000
# thinkingConfig level (MINIMAL | LOW | ... | none). Dropped automatically for models that reject it.
# GEMINI_THINKING=MINIMAL

# HTTPS for two-laptop play (camera and microphone need a secure context).
# HTTPS=1 uses frontend/certificates/localhost-key.pem + localhost.pem created by `npm run dev:frontend:https`.
# HTTPS=1
# Or point at any key/cert pair:
# HTTPS_KEY=../frontend/certificates/localhost-key.pem
# HTTPS_CERT=../frontend/certificates/localhost.pem

# Invite links default to <scheme>://<LAN IP>:3000 (https when the backend runs HTTPS).
# PUBLIC_FRONTEND_URL=https://workshift.example
# FRONTEND_PORT=3000
